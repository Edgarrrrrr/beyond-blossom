# Fixed source archives are part of every source distribution.
option(BB_OFFLINE "Use only explicit local or bundled dependency sources" ON)
set(BB_VENDOR_ROOT "${CMAKE_CURRENT_LIST_DIR}/../vendor")
if(POLICY CMP0135)
    cmake_policy(SET CMP0135 NEW)
endif()
function(bb_declare_vendored_dependency name archive sha repository revision)
    string(TOUPPER "${name}" upper)
    if(FETCHCONTENT_SOURCE_DIR_${upper})
        FetchContent_Declare(${name} SOURCE_DIR "${FETCHCONTENT_SOURCE_DIR_${upper}}")
    elseif(EXISTS "${BB_VENDOR_ROOT}/${archive}")
        FetchContent_Declare(${name} URL "${BB_VENDOR_ROOT}/${archive}" URL_HASH "SHA256=${sha}")
    elseif(BB_OFFLINE)
        message(FATAL_ERROR "Missing vendored ${name}: ${BB_VENDOR_ROOT}/${archive}; restore the complete source distribution or set FETCHCONTENT_SOURCE_DIR_${upper}")
    else()
        FetchContent_Declare(${name} GIT_REPOSITORY "${repository}" GIT_TAG "${revision}")
    endif()
endfunction()
