  "input_order": "Original archived shot order in every batch; no per-batch reshuffle",
  "stage_clock_policy": "Only stages mode has internal clocks; smoke disables all clocks. Preserve all 10000 adjacent-read calibration values and summary without subtraction. Split lacks normal CorrelationScope/zero-value normalization/error-reset and adds skip checks; matched whole-batch controls are mandatory.",
  "pmu_policy": {
    "events": [
      "PERF_COUNT_HW_CPU_CYCLES",
      "PERF_COUNT_HW_INSTRUCTIONS"
    ],
    "pid": 0,
    "cpu": -1,
    "inherit": false,
    "exclude_kernel": true,
    "exclude_hv": true,
    "leader_pinned": true,
    "multiplexing": "Reject unless time_enabled equals time_running and both are nonzero",
    "scope": "Whole batch only; no per-stage ioctl",
    "ordinary_batch_clock_reads": "Inside the PMU window; documented overhead",
    "reset_used": false,
    "raw_reads": "Read full group while disabled before enable and after disable; retain raw arrays, IDs, read bytes, errno and event attrs",
    "batch_values": "Both counts and enabled/running are end minus start, not cumulative",
    "disabled_values": "CSV marks pmu_collected=false and leaves hardware count/time fields empty; no zero-count interpretation",
    "reset_semantics_source": "https://man7.org/linux/man-pages/man2/perf_event_open.2.html#DESCRIPTION"
  },
  "checks": {
    "candidate": "Per-shot weight and observable exact against normal-off sequence",
    "source241_official": "Per-shot weight exact; observable differences recorded under existing generic policy",
    "source_vector": "Candidate normal-off additionally checked against original source241 per-shot int64 weights",
    "restrictions": [
      "No negative weights",
      "No boundary edges/user boundary nodes",
      "No correlations",
      "Every on shot must take skipped fallback",
      "Input duplicates and bounds validated at load and retained in ordinary off seeding loop"
    ],
    "lifecycle": "Real prepare/gate/root creation, flood loop and shatter extraction; no full reset substitute"
  },
  "outliers": "Retain every batch/process/failed attempt, no trimming. Failures invalidate the affected process; do not overwrite outputs.",
  "aggregation": "Per-process median of 20 batch means, then paired six-process summaries; repeated batches are not independent inputs.",
  "notes": [
    "Normal/split are controls for copied-driver code-layout/call overhead.",
    "Prefix delta compares prepare+gate+on roots with off validation+roots; tail differences may reflect cache effects.",
    "No unsupported per-phase PMU attribution; this collector measures per-phase clocks and whole-batch counters.",
    "Only explicit parent GO authorizes --measure execution; current permission is build and correctness-only smoke."
  ],
